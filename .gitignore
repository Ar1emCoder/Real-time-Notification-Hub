# .env.example
```env
# --- Database ---
POSTGRES_USER=notification_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=notification_hub
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO